# Added by cargo

/target

# Credentials
.keys

# Swift package build artifacts (regenerated by swift/build-xcframework.sh).
#
# SWIFT-2 (issue #110): these rules landed on `main` ahead of the binding
# itself. A working tree that has built the binding holds ~974 MB of
# artifacts — `.build/`, `.xcbuild/`, and a `Chisel.xcframework/` with three
# prebuilt static archives — and one `git add -A` would commit the lot into
# history, which is not recoverable without a rewrite.
swift/Chisel.xcframework/
swift/.build/
swift/.xcbuild/
swift/*.o
swift/*.d
swift/*.swiftdeps
swift/*.swiftdeps~
swift/Chisel.xcframework.zip

# SwiftPM resolves the root manifest, so its build directory is at the root too.
/.build/
/.swiftpm/
